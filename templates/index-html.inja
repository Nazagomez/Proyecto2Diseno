<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | Inicio</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>

  <header>
    <div class="lv-topbar py-3">
      <div class="container">
        <div class="row align-items-center g-2">
          <div class="col-auto">
            <a href="index.html" class="lv-logo text-decoration-none d-flex align-items-center gap-2">
              <i class="bi bi-bookmark-fill fs-3 text-warning"></i>
              <span>{{ title }}<small>Tu librería en línea</small></span>
            </a>
          </div>
          <div class="col">
            <form class="d-flex" action="busqueda.html" method="get">
              <input class="form-control rounded-pill" type="search" name="q" placeholder="Buscar libro, autor, categoría...">
              <button class="btn btn-light ms-2 rounded-pill" type="submit"><i class="bi bi-search"></i></button>
            </form>
          </div>
          <div class="col-auto">
            <a href="carrito.html" class="btn btn-outline-light">
              <i class="bi bi-cart3"></i> Carrito <span class="badge text-bg-danger">3</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark lv-navbar lv-sans">
      <div class="container">
        <div class="collapse navbar-collapse show">
          <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link active" href="index.html">Inicio</a></li>
            <li class="nav-item"><a class="nav-link" href="libros/index.html">Catálogo</a></li>
            <li class="nav-item"><a class="nav-link" href="busqueda.html">Búsqueda</a></li>
            <li class="nav-item"><a class="nav-link" href="carrito.html">Carrito</a></li>
            <li class="nav-item"><a class="nav-link" href="facturacion.html">Facturación</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <main class="container my-4">
    <div id="heroCarousel" class="carousel slide lv-hero shadow-sm" data-bs-ride="carousel">
      <div class="carousel-inner">
        <div class="carousel-item active">
          <div class="row align-items-center">
            <div class="col-md-8">
              <h1>{{ message }}</h1>
              <p class="mb-4">{{ description }}</p>
              <a href="libros/index.html" class="btn btn-danger btn-lg">Ver catálogo</a>
            </div>
            <div class="col-md-4 text-center d-none d-md-block">
              <i class="bi bi-journal-bookmark-fill display-1 text-warning"></i>
            </div>
          </div>
        </div>

        <div class="carousel-item">
          <div class="row align-items-center">
            <div class="col-md-8">
              <h1>Novedades de la semana</h1>
              <p class="mb-4">Los lanzamientos más esperados ya están disponibles. Reserva el tuyo antes de que se agote.</p>
              <a href="libros/index.html" class="btn btn-danger btn-lg">Ver novedades</a>
            </div>
            <div class="col-md-4 text-center d-none d-md-block">
              <i class="bi bi-star-fill display-1 text-warning"></i>
            </div>
          </div>
        </div>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>

    <section class="mt-5">
      <h2 class="lv-section-title">Secciones del sitio</h2>
      <div class="row g-3">
        <div class="col-md-4">
          <a href="libros/index.html" class="lv-cat-tile text-decoration-none">
            <i class="bi bi-book fs-2"></i>
            <span>Catálogo de libros</span>
          </a>
        </div>
        <div class="col-md-4">
          <a href="busqueda.html" class="lv-cat-tile text-decoration-none">
            <i class="bi bi-search fs-2"></i>
            <span>Búsqueda</span>
          </a>
        </div>
        <div class="col-md-4">
          <a href="carrito.html" class="lv-cat-tile text-decoration-none">
            <i class="bi bi-cart fs-2"></i>
            <span>Carrito</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="lv-footer py-5 mt-5">
    <div class="container text-center small">{{ footer }}. Contacto: {{ contact }}</div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>