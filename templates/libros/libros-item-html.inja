<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ titulo }} | Librería Letras Vivas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="../css/styles.css">
</head>
<body data-page="detalle">

  <header>
    <div class="lv-topbar py-3">
      <div class="container">
        <div class="row align-items-center g-2">
          <div class="col-auto">
            <a href="../index.html" class="lv-logo text-decoration-none d-flex align-items-center gap-2">
              <i class="bi bi-bookmark-fill fs-3 text-warning"></i>
              <span>Librería Letras Vivas<small>Tu librería en línea</small></span>
            </a>
          </div>
          <div class="col">
            <form class="d-flex" action="../busqueda.html" method="get">
              <input class="form-control rounded-pill" type="search" name="q" placeholder="Buscar libro, autor, categoría...">
              <button class="btn btn-light ms-2 rounded-pill" type="submit"><i class="bi bi-search"></i></button>
            </form>
          </div>
          <div class="col-auto">
            <a href="../carrito.html" class="btn btn-outline-light">
              <i class="bi bi-cart3"></i> Carrito <span class="badge text-bg-danger">3</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark lv-navbar lv-sans">
      <div class="container">
        <div class="collapse navbar-collapse show">
          <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="../index.html">Inicio</a></li>
            <li class="nav-item"><a class="nav-link active" href="index.html">Catálogo</a></li>
            <li class="nav-item"><a class="nav-link" href="../busqueda.html">Búsqueda</a></li>
            <li class="nav-item"><a class="nav-link" href="../carrito.html">Carrito</a></li>
            <li class="nav-item"><a class="nav-link" href="../facturacion.html">Facturación</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <div class="lv-breadcrumb-bar py-2 lv-sans">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="../index.html">Inicio</a></li>
          <li class="breadcrumb-item"><a href="index.html">Catálogo</a></li>
          <li class="breadcrumb-item active">{{ titulo }}</li>
        </ol>
      </nav>
    </div>
  </div>

  <main class="container my-4">
    <div class="row g-4">
      <div class="col-md-5 col-lg-4">
        <img src="../{{ imagen }}" class="img-fluid rounded shadow-sm lv-book-cover w-100" alt="{{ titulo }}" onerror="this.src='../images/placeholder.svg'">
      </div>

      <div class="col-md-7 col-lg-8">
        <span class="badge text-bg-secondary mb-2">{{ categoria }}</span>
        <h1 class="lv-section-title">{{ titulo }}</h1>
        <p class="text-muted mb-2">Por <strong>{{ autor }}</strong> &middot; {{ editorial }} &middot; {{ anio }}</p>

        <p class="lv-price fs-3 mb-3">₡{{ precio }}</p>

        <p class="mb-4">{{ descripcion }}</p>

        <div class="row g-2 mb-4 lv-sans">
          <div class="col-6 col-md-4">
            <span class="text-muted small d-block">Idioma</span>
            <strong>{{ idioma }}</strong>
          </div>
          <div class="col-6 col-md-4">
            <span class="text-muted small d-block">Formato</span>
            <strong>{{ formato }}</strong>
          </div>
          <div class="col-6 col-md-4">
            <span class="text-muted small d-block">Páginas</span>
            <strong>{{ paginas }}</strong>
          </div>
          <div class="col-6 col-md-4">
            <span class="text-muted small d-block">ISBN</span>
            <strong>{{ isbn }}</strong>
          </div>
          <div class="col-6 col-md-4">
            <span class="text-muted small d-block">Disponibilidad</span>
            <strong>{{ estado }}</strong>
          </div>
          <div class="col-6 col-md-4">
            <span class="text-muted small d-block">Existencias</span>
            <strong>{{ stock }} unidades</strong>
          </div>
        </div>

        <div class="d-flex gap-2">
          <a href="../carrito.html" class="btn btn-danger btn-lg">
            <i class="bi bi-cart-plus"></i> Agregar al carrito
          </a>
          <a href="index.html" class="btn btn-outline-secondary btn-lg">
            ← Volver al catálogo
          </a>
        </div>
      </div>
    </div>
  </main>

  <footer class="lv-footer py-5 mt-5">
    <div class="container text-center small">© 2026 Librería Letras Vivas. Todos los derechos reservados.</div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
