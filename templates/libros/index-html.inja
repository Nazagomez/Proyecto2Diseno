<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo | Librería Letras Vivas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="../css/styles.css">
</head>
<body>

  <header>
    <div class="lv-topbar py-3">
      <div class="container">
        <div class="row align-items-center g-2">
          <div class="col-auto">
            <a href="../index.html" class="lv-logo text-decoration-none d-flex align-items-center gap-2">
              <i class="bi bi-bookmark-fill fs-3 text-warning"></i>
              <span>Librería Letras Vivas<small>Tu librería en línea</small></span>
            </a>
          </div>
          <div class="col">
            <form class="d-flex" action="../busqueda.html" method="get">
              <input class="form-control rounded-pill" type="search" name="q" placeholder="Buscar libro, autor, categoría...">
              <button class="btn btn-light ms-2 rounded-pill" type="submit"><i class="bi bi-search"></i></button>
            </form>
          </div>
          <div class="col-auto">
            <a href="../carrito.html" class="btn btn-outline-light">
              <i class="bi bi-cart3"></i> Carrito <span class="badge text-bg-danger">3</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark lv-navbar lv-sans">
      <div class="container">
        <div class="collapse navbar-collapse show">
          <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" href="../index.html">Inicio</a></li>
            <li class="nav-item"><a class="nav-link active" href="index.html">Catálogo</a></li>
            <li class="nav-item"><a class="nav-link" href="../busqueda.html">Búsqueda</a></li>
            <li class="nav-item"><a class="nav-link" href="../carrito.html">Carrito</a></li>
            <li class="nav-item"><a class="nav-link" href="../facturacion.html">Facturación</a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  <div class="lv-breadcrumb-bar py-2 lv-sans">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="../index.html">Inicio</a></li>
          <li class="breadcrumb-item active">Catálogo</li>
        </ol>
      </nav>
    </div>
  </div>

  <main class="container my-4">
    <div class="row g-4">
      <aside class="col-lg-3">
        <div class="lv-sidebar lv-sans">
          <h3>Categorías</h3>
          <p class="text-muted small">Catálogo generado con JSON e INJA.</p>
          <a href="index.html" class="btn btn-primary w-100">Todos los libros</a>
        </div>
      </aside>

      <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="lv-section-title mb-0">Todos los libros</h2>
          <span class="text-muted lv-sans small">Catálogo generado estáticamente</span>
        </div>

        <div class="row g-3">
          {% for libro in page_list %}
          <div class="col-6 col-md-4 col-lg-4">
            <div class="card lv-book-card h-100">
              <img src="../{{ libro.imagen }}" class="card-img-top lv-book-cover" alt="{{ libro.titulo }}" onerror="this.src='../images/placeholder.svg'">
              <div class="card-body d-flex flex-column">
                <h3 class="card-title h6 lv-book-title">{{ libro.titulo }}</h3>
                <p class="card-text text-muted small mb-1">{{ libro.autor }}</p>
                <span class="badge text-bg-secondary mb-2">{{ libro.categoria }}</span>
                <div class="mt-auto d-flex justify-content-between align-items-center">
                  <span class="lv-price">₡{{ libro.precio }}</span>
                  <a href="{{ libro._stem }}.html" class="btn btn-outline-primary btn-sm">Detalle</a>
                </div>
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </main>

  <footer class="lv-footer py-5 mt-5">
    <div class="container text-center small">© 2026 Librería Letras Vivas. Todos los derechos reservados.</div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>